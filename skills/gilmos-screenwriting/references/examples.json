{
  "note": "Argument templates only. Replace {{...}} values with accessible project records, actual model choices and an authorized budget before calling. These are not executed production tests.",
  "examples": [
    {
      "purpose": "Create a separate short screenplay while preserving production scenes",
      "tool": "gilmos_create_screenplay",
      "arguments": {
        "projectId": "{{projectId}}",
        "payload": {
          "title": "The Signal",
          "syncScenes": false,
          "blocks": [
            {
              "type": "scene_heading",
              "text": "EXT. FOREST - DAY",
              "sceneNumber": "1"
            },
            {
              "type": "action",
              "text": "ROZ stops at the edge of the forest. A distant signal pulses."
            },
            {
              "type": "character",
              "text": "ROZ"
            },
            {
              "type": "dialogue",
              "text": "I hear you."
            }
          ]
        }
      }
    },
    {
      "purpose": "Start exactly one authorized long screenplay run; use the approved budget",
      "tool": "gilmos_write_long_screenplay",
      "arguments": {
        "projectId": "{{projectId}}",
        "payload": {
          "title": "The Signal",
          "brief": "{{brief}}",
          "targetMinutes": 120,
          "tokenBudget": "{{tokenBudget}}",
          "language": "français",
          "requestKey": "{{requestId}}"
        }
      }
    },
    {
      "purpose": "Read the actual persistent writing state",
      "tool": "gilmos_get_screenplay_writing",
      "arguments": {
        "projectId": "{{projectId}}",
        "payload": {
          "runId": "{{runId}}"
        }
      }
    },
    {
      "purpose": "Pause a writing run when the user asks",
      "tool": "gilmos_control_screenplay_writing",
      "arguments": {
        "projectId": "{{projectId}}",
        "payload": {
          "runId": "{{runId}}",
          "action": "pause"
        }
      }
    },
    {
      "purpose": "Correct paragraph types without rewriting the words",
      "tool": "gilmos_correct_screenplay_formatting",
      "arguments": {
        "projectId": "{{projectId}}",
        "payload": {
          "screenplayId": "{{screenplayId}}"
        }
      }
    }
  ]
}
