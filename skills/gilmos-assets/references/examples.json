{
  "note": "Argument templates only. Replace {{...}} values with accessible project records, actual model choices and an authorized budget before calling. These are not executed production tests.",
  "examples": [
    {
      "purpose": "Create one asset record, without generating an image",
      "tool": "gilmos_create_assets",
      "arguments": {
        "projectId": "{{projectId}}",
        "payload": {
          "assets": [
            {
              "name": "ROZ",
              "type": "character",
              "description": "A production character; retain the approved design.",
              "characterRole": "main"
            }
          ]
        }
      }
    },
    {
      "purpose": "Read all versions before using or selecting a particular image",
      "tool": "gilmos_read_asset_versions",
      "arguments": {
        "projectId": "{{projectId}}",
        "payload": {
          "assetId": "{{assetId}}"
        }
      }
    },
    {
      "purpose": "Select an existing version only when the user requests that active choice",
      "tool": "gilmos_select_asset_version",
      "arguments": {
        "projectId": "{{projectId}}",
        "payload": {
          "assetId": "{{assetId}}",
          "versionNumber": 1
        }
      }
    },
    {
      "purpose": "Complete missing descriptions for an explicit set",
      "tool": "gilmos_start_asset_description_workflow",
      "arguments": {
        "projectId": "{{projectId}}",
        "payload": {
          "resourceIds": [
            "{{assetId}}"
          ],
          "onlyMissing": true,
          "language": "français"
        }
      }
    },
    {
      "purpose": "Generate one authorized reference image saved as an asset version",
      "tool": "gilmos_start_asset_image_workflow",
      "arguments": {
        "projectId": "{{projectId}}",
        "payload": {
          "resourceIds": [
            "{{assetId}}"
          ],
          "model": "{{imageModel}}",
          "onlyMissing": false,
          "instruction": "Preserve the established character design."
        }
      }
    },
    {
      "purpose": "Generate a native character sheet from the explicitly chosen version",
      "tool": "gilmos_run_sandbox_recipe",
      "arguments": {
        "projectId": "{{projectId}}",
        "payload": {
          "action": "character_reference_sheet",
          "targetAssetId": "{{assetId}}",
          "assetVersions": [
            {
              "assetId": "{{assetId}}",
              "versionId": "{{versionId}}"
            }
          ],
          "output": "asset_version"
        }
      }
    },
    {
      "purpose": "Show a stored asset image without generating again",
      "tool": "gilmos_get_media",
      "arguments": {
        "projectId": "{{projectId}}",
        "table": "asset_versions",
        "id": "{{versionId}}"
      }
    }
  ]
}
