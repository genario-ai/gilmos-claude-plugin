{
  "note": "Argument templates only. Replace {{...}} values with accessible project records, actual model choices and an authorized budget before calling. These are not executed production tests.",
  "examples": [
    {
      "purpose": "Read the project context",
      "tool": "gilmos_get_project",
      "arguments": {
        "projectId": "{{projectId}}"
      }
    },
    {
      "purpose": "Continue paging active scene records; filter deleted records locally",
      "tool": "gilmos_read_resources",
      "arguments": {
        "projectId": "{{projectId}}",
        "table": "scenes",
        "offset": 50,
        "limit": 50
      }
    },
    {
      "purpose": "Save one full project knowledge document",
      "tool": "gilmos_create_project_document",
      "arguments": {
        "projectId": "{{projectId}}",
        "payload": {
          "title": "Continuity decisions",
          "content": "# Continuity\nKeep the selected character references for the approved shots."
        }
      }
    },
    {
      "purpose": "Create one production task",
      "tool": "gilmos_create_task",
      "arguments": {
        "projectId": "{{projectId}}",
        "payload": {
          "title": "Review scene 3 continuity",
          "content": "Check the selected ROZ version before final images."
        }
      }
    },
    {
      "purpose": "Assign an explicit resource list to a known member",
      "tool": "gilmos_assign_resources",
      "arguments": {
        "projectId": "{{projectId}}",
        "payload": {
          "resourceType": "scene",
          "resourceIds": [
            "{{sceneId}}"
          ],
          "assigneeId": "{{assigneeId}}"
        }
      }
    },
    {
      "purpose": "Record an authorized scene approval",
      "tool": "gilmos_set_status",
      "arguments": {
        "projectId": "{{projectId}}",
        "payload": {
          "resourceType": "scene",
          "resourceId": "{{sceneId}}",
          "status": "approved"
        }
      }
    },
    {
      "purpose": "Comment on an explicit resource",
      "tool": "gilmos_create_comment",
      "arguments": {
        "projectId": "{{projectId}}",
        "payload": {
          "resourceType": "scene",
          "resourceId": "{{sceneId}}",
          "content": "Continuity reviewed against the selected reference."
        }
      }
    },
    {
      "purpose": "Patch one read sandbox item without overwriting concurrent changes",
      "tool": "gilmos_edit_sandbox",
      "arguments": {
        "projectId": "{{projectId}}",
        "changes": [
          {
            "id": "{{itemId}}",
            "action": "update",
            "expected": {
              "name": "Draft"
            },
            "patch": {
              "name": "Reference selected"
            }
          }
        ]
      }
    }
  ]
}
